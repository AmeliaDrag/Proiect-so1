void pid_file(){
  int fd = open(PID_FILE | O_WRONLY | O_CREAT | O_TRUNC, 0644);

  if(fd==-1){
    perror("ERROR la creare .monitor_pid");
    return;
  }

  pid_t pid=getpid();

  char buf[32];
  snprintf(buf, sizeof(buf), "%d\n", pid);

  write(fd, buf, strlen(buf));
  close(fd);

  //printf();
}

